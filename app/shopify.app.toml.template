# MGD Slider - shopify.app.toml Vorlage (0.2.0 Pre-Alpha)
# Nur Platzhalter, KEINE echten Werte, keine Secrets.
# Benutzen: Datei kopieren > "shopify.app.toml" (Ordner app/ oder Repo-Wurzel, siehe README),
# dann "shopify app config link" ausführen. Das trägt client_id selbst ein.
# shopify.app.toml mit echter client_id NICHT committen.

# client_id kommt aus dem Partner Dashboard (leer lassen, "config link" füllt es)
client_id = ""
name = "MGD Slider"
# Theme App Extension braucht kein Backend > Platzhalter-URL, später durch echte ersetzen
application_url = "https://example.com"
embedded = false

[access_scopes]
# Block liest Produkte direkt per Liquid > keine Scopes nötig
scopes = ""

[auth]
redirect_urls = [ "https://example.com/api/auth" ]

[webhooks]
api_version = "2026-10"
